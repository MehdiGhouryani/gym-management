{
  "name": "@fulad/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fulad/shared": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "@prisma/client": "^6",
    "cookie-parser": "^1.4.7",
    "helmet": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/node": "^22",
    "prisma": "^6",
    "tsx": "^4",
    "vitest": ">=3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
