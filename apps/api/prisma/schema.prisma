generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  STAFF
}

enum GymStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PayMethod {
  CASH
  CARD
  POS
}

enum PlanKind {
  days
  sessions
}

enum ReminderStatus {
  QUEUED
  SENT
  FAILED
}

enum RequestType {
  JOIN
  RENEW
}

enum RequestStatus {
  OPEN
  APPROVED
  REJECTED
}

enum CheckInMethod {
  QR
  MANUAL
}

enum BookingStatus {
  BOOKED
  CANCELLED
  ATTENDED
  WAITLIST
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

model Gym {
  id            String         @id @default(uuid())
  slug          String         @unique
  name          String
  city          String
  address       String?
  phone         String?
  status        GymStatus      @default(PENDING)
  expiringDays  Int            @default(7)
  graceDays     Int            @default(14)
  createdAt     DateTime       @default(now())
  users         User[]
  members       Member[]
  plans         Plan[]
  subscriptions Subscription[]
  payments      Payment[]
  reminders     Reminder[]
  requests      Request[]
  auditLogs     AuditLog[]
  idempotencyKeys IdempotencyKey[]
  planPriceHistories PlanPriceHistory[]
  refunds       Refund[]
  leads         Lead[]
  attendances   Attendance[]
  bookings      Booking[]
  coaches       Coach[]
  classes       Class[]
  classSessions ClassSession[]

  @@map("gyms")
}

model User {
  id           String   @id @default(uuid())
  role         Role
  gymId        String?
  gym          Gym?     @relation(fields: [gymId], references: [id])
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  totpSecret   String?
  createdAt    DateTime @default(now())

  @@map("users")
}

model Member {
  id            String         @id @default(uuid())
  gymId         String
  gym           Gym            @relation(fields: [gymId], references: [id])
  name          String
  phone         String
  birthDate     DateTime?      @db.Date
  note          String?
  archivedAt    DateTime?
  // آخرین روز معتبر اشتراک؛ فقط بخش اشتراک آن را در همان تراکنشِ ثبت یا تمدید به‌روز می‌کند (وضعیت از روی آن محاسبه می‌شود)
  currentEndsOn DateTime?      @db.Date
  // بدهی کل عضو (تومان) = جمع اشتراک‌ها منهای جمع پرداخت‌ها به‌علاوه‌ی جمع بازپرداخت‌ها؛ همیشه از ردیف‌ها دوباره محاسبه می‌شود
  balance       Int            @default(0)
  /** عضو پیامک یادآوری نمی‌خواهد (رضایت اعلان‌ها) */
  smsOptOut     Boolean        @default(false)
  /** برچسب‌های آزاد برای دسته‌بندی (مثل «کشتی»، «کراس‌فیت») */
  tags          String[]       @default([])
  /** توکن امن QR ورود — بدون اطلاعات خصوصی؛ فقط برای اسکن پذیرش */
  qrToken       String         @unique @default(uuid())
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  refunds       Refund[]
  leads         Lead[]
  attendances   Attendance[]
  reminders     Reminder[]
  bookings      Booking[]
  requests      Request[]

  @@unique([gymId, phone])
  // برای کلید خارجی ترکیبی: هیچ اشتراک/یادآوری/درخواستی از باشگاه دیگر به این عضو اشاره نمی‌کند
  @@unique([id, gymId])
  @@index([gymId, name])
  @@index([gymId, currentEndsOn])
  @@index([gymId, balance])
  @@map("members")
}

model Plan {
  id            String         @id @default(uuid())
  gymId         String
  gym           Gym            @relation(fields: [gymId], references: [id])
  name          String
  kind          PlanKind       @default(days)
  days          Int
  /** فقط برای پلن جلسه‌ای: تعداد جلسه‌های مجاز */
  sessionsCount Int?
  price         Int
  active        Boolean        @default(true)
  subscriptions Subscription[]
  priceHistory  PlanPriceHistory[]

  // نام یکتا در هر باشگاه (بی‌توجه به بزرگی/کوچکی حروف در سطح سرویس کنترل می‌شود)
  @@unique([gymId, name])
  @@unique([id, gymId])
  @@index([gymId])
  @@map("plans")
}

model Subscription {
  id           String    @id @default(uuid())
  gymId        String
  gym          Gym       @relation(fields: [gymId], references: [id])
  memberId     String
  member       Member    @relation(fields: [memberId, gymId], references: [id, gymId])
  planId       String
  plan         Plan      @relation(fields: [planId, gymId], references: [id, gymId])
  startsOn     DateTime  @db.Date
  endsOn       DateTime  @db.Date
  price        Int
  /** جمع روزهای توقف موقت اعمال‌شده روی این اشتراک */
  frozenDays   Int       @default(0)
  /** زمان لغو؛ لغو‌شده از محاسبه‌ی پایان عضو و گزارش‌ها کنار می‌رود */
  cancelledAt  DateTime?
  /** جلسه‌های مصرف‌شده (پلن جلسه‌ای)؛ با حضور و غیاب فاز ۱۶ کم می‌شود */
  sessionsUsed Int?
  createdAt    DateTime  @default(now())
  payments     Payment[]

  @@unique([id, gymId])
  @@index([gymId, endsOn])
  @@index([memberId, endsOn])
  @@map("subscriptions")
}

model PlanPriceHistory {
  id      String   @id @default(uuid())
  gymId   String
  gym     Gym      @relation(fields: [gymId], references: [id])
  planId  String
  plan    Plan     @relation(fields: [planId, gymId], references: [id, gymId])
  price   Int
  days    Int
  at      DateTime @default(now())

  @@index([gymId, planId, at])
  @@map("plan_price_histories")
}

model Payment {
  id             String       @id @default(uuid())
  gymId          String
  gym            Gym          @relation(fields: [gymId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId, gymId], references: [id, gymId])
  amount         Int
  method         PayMethod
  paidAt         DateTime     @default(now())

  @@index([gymId, paidAt])
  @@map("payments")
}

/// سند معکوس: بازپرداخت هرگز پرداخت را حذف یا ویرایش نمی‌کند؛ سند جداگانه ثبت می‌شود
/// سرنخ فروش: متقاضی که هنوز عضو نشده؛ چرخه: NEW → CONTACTED → TRIAL → CONVERTED/LOST
model Lead {
  id        String     @id @default(uuid())
  gymId     String
  gym       Gym        @relation(fields: [gymId], references: [id])
  name      String
  phone     String
  status    LeadStatus @default(NEW)
  /** منبع: معرف، اینستاگرام، سایت و… */
  source    String?
  note      String?
  /** بعد از تبدیل به عضو پر می‌شود */
  memberId  String?
  member    Member?    @relation(fields: [memberId, gymId], references: [id, gymId])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([gymId, phone])
  @@index([gymId, status])
  @@map("leads")
}

/// حضور و غیاب: ورود با اسکن QR یا ثبت دستی با علت
model Attendance {
  id            String        @id @default(uuid())
  gymId         String
  gym           Gym           @relation(fields: [gymId], references: [id])
  memberId      String
  member        Member        @relation(fields: [memberId, gymId], references: [id, gymId])
  method        CheckInMethod @default(QR)
  /** برای ثبت دستی: چرا ورود دستی بود */
  note          String?
  checkInAt     DateTime      @default(now())

  @@index([gymId, checkInAt])
  @@index([memberId, checkInAt])
  @@map("attendances")
}

/// مربی باشگاه
model Coach {
  id        String  @id @default(uuid())
  gymId     String
  gym       Gym     @relation(fields: [gymId], references: [id])
  name      String
  specialty String?
  phone     String?
  active    Boolean @default(true)
  classes   Class[]

  @@unique([id, gymId])

  @@index([gymId])
  @@map("coaches")
}

/// کلاس گروهی با مربی و ظرفیت
model Class {
  id         String         @id @default(uuid())
  gymId      String
  gym        Gym            @relation(fields: [gymId], references: [id])
  coachId    String?
  coach      Coach?         @relation(fields: [coachId, gymId], references: [id, gymId])
  name       String
  capacity   Int            @default(12)
  /** مدت جلسه (دقیقه) */
  durationMin Int           @default(60)
  active     Boolean        @default(true)
  sessions   ClassSession[]

  @@unique([id, gymId])

  @@unique([gymId, name])
  @@index([gymId])
  @@map("classes")
}

/// یک جلسه‌ی برگزاری کلاس
model ClassSession {
  id        String   @id @default(uuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId, gymId], references: [id, gymId])
  startsAt  DateTime
  bookings  Booking[]

  @@unique([id, gymId])

  @@index([gymId, classId, startsAt])
  @@map("class_sessions")
}

/// رزرو عضو؛ پر شدن ظرفیت → WAITLIST و با لغو، اول انتظار ارتقا می‌یابد
model Booking {
  id        String        @id @default(uuid())
  gymId     String
  gym       Gym           @relation(fields: [gymId], references: [id])
  sessionId String
  session   ClassSession  @relation(fields: [sessionId, gymId], references: [id, gymId])
  memberId  String
  member    Member        @relation(fields: [memberId, gymId], references: [id, gymId])
  status    BookingStatus @default(BOOKED)
  createdAt DateTime      @default(now())

  @@unique([sessionId, memberId])
  @@index([gymId, sessionId, status])
  @@map("bookings")
}

model Refund {
  id        String    @id @default(uuid())
  gymId     String
  gym       Gym       @relation(fields: [gymId], references: [id])
  memberId  String
  member    Member    @relation(fields: [memberId, gymId], references: [id, gymId])
  amount    Int
  method    PayMethod
  reason    String?
  refundedAt DateTime @default(now())

  @@index([gymId, refundedAt])
  @@index([memberId, refundedAt])
  @@map("refunds")
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model Reminder {
  id         String         @id @default(uuid())
  gymId      String
  gym        Gym            @relation(fields: [gymId], references: [id])
  memberId   String
  member     Member         @relation(fields: [memberId, gymId], references: [id, gymId])
  template   String
  status     ReminderStatus @default(QUEUED)
  /** تلاش‌های ارسال؛ بعد از ۳ تلاش ناموفق FAILED می‌شود */
  attempts   Int            @default(0)
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())

  @@index([memberId, createdAt])
  @@index([gymId, status])
  @@map("reminders")
}

model Request {
  id        String        @id @default(uuid())
  gymId     String
  gym       Gym           @relation(fields: [gymId], references: [id])
  memberId  String?
  member    Member?       @relation(fields: [memberId, gymId], references: [id, gymId])
  phone     String
  name      String?
  type      RequestType
  status    RequestStatus @default(OPEN)
  createdAt DateTime      @default(now())

  @@index([gymId, status])
  @@map("requests")
}

model AuditLog {
  id       String   @id @default(uuid())
  gymId    String?
  gym      Gym?     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  actorId  String?
  action   String
  target   String?
  meta     Json?
  ip       String?
  at       DateTime @default(now())

  @@index([gymId, at])
  @@index([actorId, at])
  @@index([at])
  @@map("audit_logs")
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])
  key         String
  requestHash String
  statusCode  Int
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // یک کلید در هر باشگاه؛ درخواست تکراری همان بدنه پاسخ اصلی را می‌گیرد و بدنه‌ی متفاوت ۴۰۹
  @@unique([gymId, key])
  @@index([gymId, expiresAt])
  @@map("idempotency_keys")
}

model RefreshToken {
  id          String    @id @default(uuid())
  familyId    String
  subjectType String
  subjectId   String
  gymId       String?
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([familyId])
  @@index([subjectType, subjectId])
  @@map("refresh_tokens")
}
