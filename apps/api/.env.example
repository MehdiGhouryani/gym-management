# نقش برنامه: سوپریوزر نیست و RLS را دور نمی‌زند (بخش «فاز ۱» در README)
DATABASE_URL=postgresql://fulad_app:CHANGE_ME@localhost:5432/fulad
# نقش مالک پایگاه داده: فقط برای مهاجرت و دستورهای prisma
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fulad
PORT=4000
WEB_ORIGIN=http://localhost:3000
TZ=Asia/Tehran
# با دستور  openssl rand -base64 48  مقدار بسازید (حداقل ۳۲ نویسه)
JWT_SECRET=
# با دستور  openssl rand -base64 24  مقدار بسازید (حداقل ۱۶ نویسه)
OTP_PEPPER=
SMS_PROVIDER=console
SMS_API_KEY=

# مستندات Swagger در /api/v1/docs؛ در production پیش‌فرض خاموش است (برای روشن‌کردن true بگذارید)
ENABLE_DOCS=true
