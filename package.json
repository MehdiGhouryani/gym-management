{
  "name": "fulad",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @fulad/api exec prisma generate",
    "db:migrate": "pnpm --filter @fulad/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @fulad/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @fulad/shared build && pnpm --filter @fulad/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
